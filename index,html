<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>2Luv Clone - Interactive Love Letters</title>
  <style>
    /* Reset & Base Styling */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #12131a;
      color: #e0e2ed;
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Navigation Bar */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 5%;
      background-color: #1b1c24;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .logo {
      font-size: 24px;
      font-weight: bold;
      color: #ff8da1;
      text-decoration: none;
      letter-spacing: 1px;
    }
    nav a {
      color: #a0a5c0;
      text-decoration: none;
      margin-left: 20px;
      font-size: 15px;
      transition: color 0.3s;
    }
    nav a:hover {
      color: #ff8da1;
    }

    /* Hero Section */
    .hero-section {
      text-align: center;
      padding: 80px 20px;
      background: linear-gradient(180deg, #1b1c24 0%, #12131a 100%);
    }
    .hero-section h1 {
      font-size: 2.8rem;
      color: #ffffff;
      margin-bottom: 20px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-section p {
      font-size: 1.2rem;
      color: #a0a5c0;
      max-width: 600px;
      margin: 0 auto 40px auto;
    }
    .cta-btn {
      background: radial-gradient(circle, #ffcbd6 0%, #ff8da1 100%);
      color: #12131a;
      padding: 15px 35px;
      font-size: 16px;
      font-weight: bold;
      text-decoration: none;
      border-radius: 30px;
      box-shadow: 0 5px 20px rgba(255, 141, 161, 0.3);
      display: inline-block;
      transition: transform 0.2s, box-shadow 0.2s;
      border: none;
      cursor: pointer;
    }
    .cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(255, 141, 161, 0.4);
    }

    /* Interactive Letter Preview Component */
    .interactive-container {
      display: flex;
      justify-content: center;
      padding: 40px 20px;
    }
    .envelope-preview {
      position: relative;
      width: 100%;
      max-width: 440px;
      height: 280px;
      background-color: #1b1c24;
      border-bottom-left-radius: 16px;
      border-bottom-right-radius: 16px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      cursor: pointer;
    }
    .envelope-preview::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: 3;
      background: 
        linear-gradient(to top right, #1b1c24 49%, rgba(255,255,255,0.02) 50%, #15161c 51%) no-repeat bottom left / 50% 100%,
        linear-gradient(to top left, #1b1c24 49%, rgba(255,255,255,0.02) 50%, #15161c 51%) no-repeat bottom right / 50% 100%;
      border-bottom-left-radius: 16px;
      border-bottom-right-radius: 16px;
    }
    .top-flap {
      position: absolute;
      top: 0; left: 0; width: 0; height: 0;
      border-left: 220px solid transparent;
      border-right: 220px solid transparent;
      border-top: 140px solid #22232d;
      transform-origin: top;
      transition: transform 0.5s ease-in-out;
      z-index: 4;
    }
    @media(max-width: 480px) {
      .top-flap {
        border-left-width: calc(45vw);
        border-right-width: calc(45vw);
      }
    }
    .letter-card {
      position: absolute;
      top: 10px; left: 5%; width: 90%; height: 250px;
      background: #1f202b;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
      z-index: 2;
    }
    .letter-card p {
      color: rgba(255,255,255,0.8);
      font-family: 'Georgia', serif;
      font-style: italic;
      margin-bottom: 10px;
    }
    .heart-seal {
      position: absolute;
      top: 115px; left: calc(50% - 25px);
      width: 50px; height: 50px;
      background: radial-gradient(circle, #ffcbd6 0%, #ff8da1 100%);
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      box-shadow: 0 5px 15px rgba(255, 141, 161, 0.4);
      z-index: 5;
      transition: transform 0.4s ease, opacity 0.4s ease;
    }
    .heart-seal::after { content: '♥'; color: white; font-size: 22px; }

    /* Open Animations Trigger Classes */
    .envelope-preview.open .top-flap {
      transform: rotateX(180deg);
      z-index: 1;
    }
    .envelope-preview.open .heart-seal {
      transform: scale(0);
      opacity: 0;
    }
    .envelope-preview.open .letter-card {
      transform: translateY(-120px);
    }

    /* Product Cards Section */
    .pricing-section {
      max-width: 900px;
      margin: 80px auto;
      padding: 0 20px;
      text-align: center;
    }
    .pricing-section h2 {
      font-size: 2rem;
      margin-bottom: 40px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
    }
    .card {
      background: #1b1c24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 16px;
      padding: 40px 30px;
      text-align: left;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .card h3 {
      font-size: 1.5rem;
      color: #ffffff;
      margin-bottom: 15px;
    }
    .card ul {
      list-style: none;
      margin-bottom: 30px;
    }
    .card ul li {
      margin-bottom: 12px;
      color: #a0a5c0;
      font-size: 15px;
    }
    .card ul li::before {
      content: "✓ ";
      color: #ff8da1;
      font-weight: bold;
      margin-right: 5px;
    }

    /* Footer */
    footer {
      background: #1b1c24;
      padding: 40px 20px;
      text-align: center;
      color: #62657a;
      font-size: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      margin-top: 100px;
    }
  </style>
</head>
<body>

  <!-- Header Navigation -->
  <header>
    <a href="#" class="logo">2luv</a>
    <nav>
      <a href="#how-it-works">How It Works</a>
      <a href="#pricing">Pricing</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <!-- Hero Content Display -->
  <section class="hero-section">
    <h1>Surprise the one you love with interactive letters</h1>
    <p>Create a private digital Letter and unlock the full ad-free experience when you are ready. Add interactive Cards as a separate upgrade.</p>
    <button class="cta-btn" onclick="toggleEnvelope()">Tap To Preview Letter</button>
  </section>

  <!-- Interactive Slider Mockup Section -->
  <section class="interactive-container">
    <div class="envelope-preview" id="previewEnvelope" onclick="toggleEnvelope()">
      <div class="top-flap"></div>
      <div class="letter-card">
        <p>Dearest One,</p>
        <p style="font-size: 14px; color: #a0a5c0; font-style: normal;">Your beautiful custom message card will rest right here...</p>
      </div>
      <div class="heart-seal"></div>
    </div>
  </section>

  <!-- Pricing Offer Plan Tiers Layout Grid -->
  <section class="pricing-section" id="pricing">
    <h2>Unlock Your Surprise Layout</h2>
    <div class="grid">
      
      <!-- Tier 1 Card -->
      <div class="card">
        <div>
          <h3>Digital Letter</h3>
          <ul>
            <li>Private digital URL link</li>
            <li>Your message text and notes</li>
            <li>Password protected access</li>
            <li>Printable layout QR Code</li>
          </ul>
        </div>
        <button class="cta-btn" style="width: 100%;">Create Letter</button>
      </div>

      <!-- Tier 2 Card -->
      <div class="card" style="border-color: #ff8da1;">
        <div>
          <h3>Interactive Bundle</h3>
          <ul>
            <li>Everything in the Letter plan</li>
            <li>16 exclusive modular display cards</li>
            <li>Unlimited custom media uploads</li>
            <li>Animated countup/countdown screens</li>
          </ul>
        </div>
        <button class="cta-btn" style="width: 100%;">Create Bundle</button>
      </div>

    </div>
  </section>

  <!-- Legal & Copyright Block Footer -->
  <footer>
    <p>© 2026 2luv Project Layout Clone. All rights reserved.</p>
  </footer>

  <script>
    // Logic handles toggling interactive letter flap up or down
    function toggleEnvelope() {
      const envelope = document.getElementById('previewEnvelope');
      envelope.classList.toggle('open');
    }
  </script>

</body>
</html>
